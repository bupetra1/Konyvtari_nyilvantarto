@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    @* Csak akkor mutatjuk a sidebar-t, ha NEM a login vagy az olvasói oldalon vagyunk *@
    @if (!IsPublicPage())
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        @if (!IsPublicPage())
        {
            <div class="top-row px-4 text-end">
                <a href="" class="btn btn-link text-danger">Kijelentkezés</a>
            </div>
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        // Feliratkozunk az útvonal változására, hogy a menü azonnal frissüljön
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }

    private bool IsPublicPage()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();
        return string.IsNullOrEmpty(relativePath) ||
               relativePath == "" ||
               relativePath.StartsWith("olvaso");
    }
}