@page "/books"
@using Share.Dtos
@using Frontend.Services
@inject IBookRepository BookService
@inject IJSRuntime JS

<div class="container mt-3">
    <h2>Könyvtári Nyilvántartó</h2>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="border rounded p-2 text-center bg-light shadow-sm">
                <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Teljes állomány</small>
                <strong class="h4">@books.Count</strong>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="border rounded p-2 text-center shadow-sm @(FilteredBooks.Count < books.Count ? "border-warning bg-warning-subtle" : "bg-light")">
                <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Szűrt találat</small>
                <strong class="h4">@FilteredBooks.Count</strong>
            </div>
        </div>
        <div class="col-md-6 text-end d-flex align-items-center justify-content-end gap-2">
            <button class="btn btn-success" @onclick="ExportToCsv">
                <i class="oi oi-share-boxed"></i> CSV Export
            </button>
            <button class="btn btn-primary" @onclick="ShowCreateForm">
                <i class="oi oi-plus"></i> Új könyv
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info alert-dismissible fade show">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    @if (showCreateForm)
    {
        <div class="card mb-4 bg-light">
            <div class="card-body">
                <h5 class="card-title">@(isEditMode ? "Könyv szerkesztése" : "Új könyv felvétele")</h5>
                <EditForm Model="newBook" OnValidSubmit="SaveBook">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">Cím</label>
                            <InputText class="form-control" @bind-Value="newBook.Title" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Szerző</label>
                            <InputText class="form-control" @bind-Value="newBook.Author" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Kiadó</label>
                            <InputText class="form-control" @bind-Value="newBook.Publisher" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Év</label>
                            <InputNumber class="form-control" @bind-Value="newBook.PublicationYear" />
                        </div>
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-success">Mentés</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => showCreateForm = false">Mégse</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th>Cím</th>
                    <th>Szerző</th>
                    <th>Kiadó</th>
                    <th style="width: 100px;">Év</th>
                    <th class="text-center" style="width: 180px;">Műveletek</th>
                </tr>
                <tr class="bg-light">
                    <td></td>
                    <td><input class="form-control form-control-sm" placeholder="Szűrés..." @bind="fTitle" @bind:event="oninput" /></td>
                    <td><input class="form-control form-control-sm" placeholder="Szűrés..." @bind="fAuthor" @bind:event="oninput" /></td>
                    <td><input class="form-control form-control-sm" placeholder="Szűrés..." @bind="fPublisher" @bind:event="oninput" /></td>
                    <td><input class="form-control form-control-sm" placeholder="Év..." @bind="fYear" @bind:event="oninput" /></td>
                    <td></td>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredBooks.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Nincs találat a szűrésnek megfelelően.</td>
                    </tr>
                }
                else
                {
                    @foreach (var book in FilteredBooks)
                    {
                        <tr>
                            <td class="small">#@book.BookId</td>
                            <td class="fw-bold">@book.Title</td>
                            <td>@book.Author</td>
                            <td>@(book.Publisher ?? "-")</td>
                            <td>@book.PublicationYear</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditBook(book)">Módosít</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBook(book.BookId)">Töröl</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<BookDto> books = new();
    private CreateBookDto newBook = new();
    private BookDto? selectedBook;
    private bool showCreateForm = false;
    private bool isEditMode = false;
    private string? message;

    private string fTitle = "";
    private string fAuthor = "";
    private string fPublisher = "";
    private string fYear = "";

    private List<BookDto> FilteredBooks => books
        .Where(b => (string.IsNullOrEmpty(fTitle) || b.Title.Contains(fTitle, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrEmpty(fAuthor) || b.Author.Contains(fAuthor, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrEmpty(fPublisher) || (b.Publisher != null && b.Publisher.Contains(fPublisher, StringComparison.OrdinalIgnoreCase))) &&
                    (string.IsNullOrEmpty(fYear) || b.PublicationYear.ToString().Contains(fYear)))
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadBooks();

    private async Task LoadBooks() => books = await BookService.GetBooksAsync();

    private void ShowCreateForm()
    {
        isEditMode = false;
        newBook = new CreateBookDto { PublicationYear = 2024 };
        showCreateForm = true;
    }

    private async Task SaveBook()
    {
        bool success = isEditMode && selectedBook != null
            ? await BookService.UpdateBookAsync(selectedBook.BookId, new BookDto { BookId = selectedBook.BookId, Title = newBook.Title, Author = newBook.Author, Publisher = newBook.Publisher, PublicationYear = newBook.PublicationYear })
            : await BookService.CreateBookAsync(newBook);

        if (success)
        {
            showCreateForm = false;
            await LoadBooks();
            message = "Adatok mentve!";
        }
    }

    private void EditBook(BookDto book)
    {
        selectedBook = book;
        isEditMode = true;
        showCreateForm = true;
        newBook = new CreateBookDto { Title = book.Title, Author = book.Author, Publisher = book.Publisher, PublicationYear = book.PublicationYear };
    }

    private async Task DeleteBook(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Biztosan törlöd?"))
        {
            await BookService.DeleteBookAsync(id);
            await LoadBooks();
        }
    }

    private async Task ExportToCsv()
    {
        // BOM karakter hozzáadása az Excel hiba ellen, és a Kiadó oszlop beillesztése
        var csvLines = new List<string> { "ID;Cim;Szerzo;Kiado;Ev" };
        csvLines.AddRange(FilteredBooks.Select(b => $"{b.BookId};{b.Title};{b.Author};{b.Publisher ?? "-"};{b.PublicationYear}"));
        
        var csvContent = "\uFEFF" + string.Join("\n", csvLines);
        await JS.InvokeVoidAsync("downloadFile", "konyvek_export.csv", csvContent);
    }
}