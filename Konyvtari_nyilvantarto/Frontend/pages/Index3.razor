@page "/olvaso"
@using Share.Dtos
@using Frontend.Services
@inject UserReaderService ReaderService

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2 class="border-bottom pb-2">Olvasói Portál</h2>
            <p class="text-muted">Itt láthatja aktuális kölcsönzéseit és a könyvtár elérhető állományát.</p>
        </div>
    </div>

    @* Olvasó váltás szimulálása *@
    <div class="card mb-4 bg-light">
        <div class="card-body py-2 d-flex align-items-center">
            <span class="me-3 fw-bold small text-uppercase">Aktuális Olvasó ID:</span>
            <input type="number" @bind="myReaderId" class="form-control form-control-sm w-auto me-2" />
            <button class="btn btn-secondary btn-sm" @onclick="LoadData">Adatok frissítése</button>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">
                    Elérhető könyvek (szabad példányok)
                </div>
                <div class="card-body p-0">
                    <div style="max-height: 450px; overflow-y: auto;">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light sticky-top">
                                <tr><th>Cím</th><th>Szerző</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var book in availableBooks)
                                {
                                    <tr>
                                        <td>@book.Title</td>
                                        <td>@book.Author</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-info">
                <div class="card-header bg-info text-white fw-bold">
                    Saját kölcsönzéseim
                </div>
                <div class="card-body">
                    @if (myLoans.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var loan in myLoans)
                            {
                                var isOverdue = loan.ReturnDate == null && loan.DueDate < DateOnly.FromDateTime(DateTime.Now);
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-1 fw-bold">@loan.BookTitle</h6>
                                        <span class="badge @(isOverdue ? "bg-danger" : "bg-primary")">
                                            @(loan.LateFee > 0 ? $"{loan.LateFee} Ft tartozás" : "Aktív")
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted">
                                        <span>Határidő: @loan.DueDate</span>
                                        @if (loan.ReturnDate != null)
                                        {
                                            <span class="text-success fw-bold">Visszahozva: @loan.ReturnDate</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="oi oi-info text-muted h1"></i>
                            <p class="text-muted mt-2">Nincs aktív kölcsönzése.</p>
                        </div>
                    }
                </div>
                @if (myLoans.Any(l => l.LateFee > 0))
                {
                    <div class="card-footer bg-danger-subtle text-danger fw-bold text-center">
                        Összes hátralék: @myLoans.Sum(l => l.LateFee) Ft
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int myReaderId = 1;
    private List<ReaderBookListDto> availableBooks = new();
    private List<ReaderLoanListDto> myLoans = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        availableBooks = await ReaderService.GetAvailableBooksAsync();
        if (myReaderId > 0)
        {
            myLoans = await ReaderService.GetMyLoansAsync(myReaderId);
        }
    }
}