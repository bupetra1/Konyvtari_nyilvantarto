@page "/olvaso"
@using Share.Dtos
@using Share.Logic
@using Frontend.Services
@inject UserReaderService ReaderService

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="oi oi-person"></i> Olvasói Portál</h2>
        <a href="" class="btn btn-outline-danger btn-sm">Kijelentkezés</a>
    </div>

    @* Belépett olvasó szimuláció *@
    <div class="alert alert-secondary d-flex align-items-center">
        <label class="me-2 mb-0">Olvasó ID:</label>
        <input type="number" @bind="myReaderId" class="form-control form-control-sm w-auto me-2" />
        <button class="btn btn-primary btn-sm" @onclick="LoadData">Frissítés</button>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">Választható könyvek (nincsenek kikölcsönözve)</div>
                <div class="card-body scrollable-card" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm">
                        <thead>
                            <tr><th>Cím</th><th>Szerző</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var book in availableBooks)
                            {
                                <tr>
                                    <td>@book.Title</td>
                                    <td>@book.Author</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-header bg-primary text-white">Saját kölcsönzéseim és tartozások</div>
                <div class="card-body">
                    @if (myLoans.Any())
                    {
                        @foreach (var loan in myLoans)
                        {
                            var isOverdue = loan.ReturnDate == null && loan.DueDate < DateOnly.FromDateTime(DateTime.Now);
                            <div class="border-bottom mb-2 pb-2">
                                <div class="d-flex justify-content-between">
                                    <strong>@loan.BookTitle</strong>
                                    <span class="badge @(isOverdue ? "bg-danger" : "bg-info")">
                                        @(loan.LateFee > 0 ? $"{loan.LateFee} Ft" : "Nincs tartozás")
                                    </span>
                                </div>
                                <small class="text-muted">Határidő: @loan.DueDate</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-muted">Nincsenek aktív kölcsönzések.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int myReaderId = 1;
    private List<ReaderBookListDto> availableBooks = new();
    private List<ReaderLoanListDto> myLoans = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        availableBooks = await ReaderService.GetAvailableBooksAsync();
        if (myReaderId > 0)
        {
            myLoans = await ReaderService.GetMyLoansAsync(myReaderId);
        }
    }
}