@page "/loans"
@using Share.Dtos
@using Frontend.Services
@inject ILoanRepository LoanService
@inject IBookRepository BookService
@inject IReaderRepository ReaderService
@inject IJSRuntime JS

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="oi oi-list"></i> Kölcsönzések kezelése</h1>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-success me-2" @onclick="ExportToCsv"><i class="oi oi-share-boxed"></i> Export</button>
            <button class="btn btn-primary shadow-sm" @onclick="ShowCreateForm">
                <span class="oi oi-plus"></span> Új kölcsönzés
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card bg-light border-primary p-2 text-center">
                <small class="text-muted text-uppercase">Összes</small>
                <div class="h4">@loans.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-light border-danger p-2 text-center text-danger">
                <small class="text-muted text-uppercase">Késésben</small>
                <div class="h4">@loans.Count(l => l.ReturnDate == null && l.DueDate < DateOnly.FromDateTime(DateTime.Now))</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card bg-light border-success p-2 text-center text-success">
                <small class="text-muted text-uppercase">Várható díj</small>
                <div class="h4">@loans.Sum(l => l.LateFee) Ft</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    @if (showCreateForm)
    {
        <div class="card mb-4 shadow border-primary bg-light">
            <div class="card-body">
                <h5 class="mb-3">@(isEditMode ? "Szerkesztés" : "Új rögzítés")</h5>
                <EditForm Model="formModel" OnValidSubmit="SaveLoan">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Olvasó:</label>
                            <InputSelect class="form-select" @bind-Value="formModel.ReaderId">
                                <option value="0">-- Válassz --</option>
                                @foreach (var reader in readers)
                                {
                                    <option value="@reader.ReaderId">@reader.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Könyv:</label>
                            <InputSelect class="form-select" @bind-Value="formModel.BookId">
                                <option value="0">-- Válassz --</option>
                                @foreach (var book in books)
                                {
                                    <option value="@book.BookId">@book.Title</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Határidő:</label>
                            <input type="date" class="form-control" @bind="formModel.DueDate" />
                        </div>
                        @if (isEditMode)
                        {
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Visszahozva ekkor:</label>
                                <input type="date" class="form-control" @bind="editDto.ReturnDate" />
                            </div>
                        }
                        <div class="col-12 mt-3">
                            <button type="submit" class="btn btn-success px-4">Mentés</button>
                            <button type="button" class="btn btn-secondary px-4" @onclick="Cancel">Mégse</button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Olvasó</th>
                        <th>Könyv</th>
                        <th>Kölcsönzés</th>
                        <th>Határidő</th>
                        <th>Visszahozva</th>
                        <th>Késedelmi díj</th>
                        <th class="text-center">Műveletek</th>
                    </tr>
                    <tr class="bg-light text-dark">
                        <th><input class="form-control form-control-sm" placeholder="Keresés..." @bind="fReader" @bind:event="oninput" /></th>
                        <th><input class="form-control form-control-sm" placeholder="Keresés..." @bind="fBook" @bind:event="oninput" /></th>
                        <th colspan="5"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in FilteredLoans)
                    {
                        var isOverdue = loan.ReturnDate == null && loan.DueDate < DateOnly.FromDateTime(DateTime.Now);
                        <tr class="@(isOverdue ? "table-danger" : "")">
                            <td>@loan.ReaderName</td>
                            <td>@loan.BookTitle</td>
                            <td>@loan.LoanDate</td>
                            <td>
                                @loan.DueDate
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">KÉSETT</span>
                                }
                            </td>
                            <td>@(loan.ReturnDate?.ToString() ?? "Nincs visszahozva")</td>
                            <td class="fw-bold @(loan.LateFee > 0 ? "text-danger" : "text-muted")">@loan.LateFee Ft</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditLoan(loan)">Módosít</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLoan(loan.LoanId)">Töröl</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<LoanDto> loans = new();
    private List<BookDto> books = new();
    private List<ReaderDto> readers = new();

    private CreateLoanDto formModel = new();
    private LoanDto editDto = new();
    
    private bool showCreateForm = false;
    private bool isEditMode = false;
    private string? message;

    // Szűrők
    private string fReader = "";
    private string fBook = "";

    private List<LoanDto> FilteredLoans => loans
        .Where(l => (string.IsNullOrEmpty(fReader) || l.ReaderName.Contains(fReader, StringComparison.OrdinalIgnoreCase)) &&
                    (string.IsNullOrEmpty(fBook) || l.BookTitle.Contains(fBook, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loans = await LoanService.GetLoansAsync();
        books = await BookService.GetBooksAsync();
        readers = await ReaderService.GetReadersAsync();
    }

    private void ShowCreateForm()
    {
        isEditMode = false;
        formModel = new CreateLoanDto { DueDate = DateOnly.FromDateTime(DateTime.Now.AddDays(14)) };
        showCreateForm = true;
    }

    private async Task SaveLoan()
    {
        bool success;
        if (isEditMode)
        {
            editDto.ReaderId = formModel.ReaderId;
            editDto.BookId = formModel.BookId;
            editDto.DueDate = formModel.DueDate;
            success = await LoanService.UpdateLoanAsync(editDto.LoanId, editDto);
        }
        else
        {
            success = await LoanService.CreateLoanAsync(formModel);
        }

        if (success) await HandleSuccess("Sikeres mentés!");
    }

    private void EditLoan(LoanDto loan)
    {
        isEditMode = true;
        editDto = loan;
        formModel = new CreateLoanDto { ReaderId = loan.ReaderId, BookId = loan.BookId, DueDate = loan.DueDate };
        showCreateForm = true;
    }

    private async Task HandleSuccess(string msg)
    {
        message = msg;
        showCreateForm = false;
        await LoadData();
    }

    private void Cancel() => showCreateForm = false;

    private async Task DeleteLoan(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Biztosan törölni akarod?"))
        {
            if (await LoanService.DeleteLoanAsync(id)) await LoadData();
        }
    }

    private async Task ExportToCsv()
    {
        var csvLines = new List<string> { "Olvaso;Konyv;Datum;Hatarido;Visszahozva;Dij" };
        csvLines.AddRange(FilteredLoans.Select(l => $"{l.ReaderName};{l.BookTitle};{l.LoanDate};{l.DueDate};{(l.ReturnDate?.ToString() ?? "-")};{l.LateFee}"));
        
        var csvContent = "\uFEFF" + string.Join("\n", csvLines);
        await JS.InvokeVoidAsync("downloadFile", "kolcsonzesek.csv", csvContent);
    }
}