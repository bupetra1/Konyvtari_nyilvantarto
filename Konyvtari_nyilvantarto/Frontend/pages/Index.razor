@page "/"
@inject NavigationManager Navigation

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 400px;">
        <div class="text-center mb-4">
            <h3>📚 Bejelentkezés</h3>
            <p class="text-muted">Kérjük, adja meg adatait!</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="mb-3">
            <label class="form-label">Felhasználónév</label>
            <input type="text" class="form-control" @bind="username" />
        </div>

        <div class="mb-3">
            <label class="form-label">Jelszó</label>
            <input type="password" class="form-control" @bind="password" />
        </div>

        <button class="btn btn-primary w-100 py-2" @onclick="HandleLogin">Bejelentkezés</button>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string? errorMessage;

    private void HandleLogin()
    {
        if (username == "konyvtaros" && password == "konyvtaros")
        {
            Navigation.NavigateTo("/konyvtaros");
        }
        else if (username == "olvaso" && password == "olvaso")
        {
            Navigation.NavigateTo("/olvaso");
        }
        else
        {
            errorMessage = "Hibás felhasználónév vagy jelszó!";
        }
    }
}